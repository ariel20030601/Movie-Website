<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/home.css" />
    <link rel="stylesheet" href="/movie.css" />
    <title>Home</title>
</head>
<body>
    <div class="navbar">
        <div><strong>Welcome, <%= username %>!</strong></div>
        <div class="nav-links">
            <a href="/profile">Profile</a>
            <a href="/home">Home</a>
        </div>
    </div>

<div class="movie-wrapper">
  <div class="movie-info">
    <h1><%= movie.title %></h1>
    <p><%= movie.description %></p>
    <div class="rating">Average Rating: <%= movie.rating %> / 10⭐</div>
  </div>
  <div class="movie-poster">
    <img src="/MoviePosters/<%= movie.imageurl %>" alt="<%= movie.title %> Poster">
  </div>
</div>


<div class="review-form-wrapper">
  <h2>Leave a Review</h2>
  <form action="/movie/<%= movie.id %>/review" method="POST">
    <label for="rating">Your Rating (1-10):</label>
    <input type="number" id="rating" name="rating" min="1" max="10" required>

    <label for="review">Your Review:</label>
    <textarea id="review" name="review" rows="4" placeholder="Share your thoughts..." required></textarea>

    <button type="submit">Submit Review</button>
  </form>
</div>

<div class="all-reviews-wrapper">
  <h2>User Reviews</h2>
  <% if (reviews.length === 0) { %>
    <p>No reviews yet. Be the first!</p>
  <% } else { %>
    <% reviews.forEach(review => { %>
      <div class="review-box">
        <div class="review-header">
          <span>Rating: <%= review.rating %> ⭐</span> - by <strong> <%= review.reviewerName %> </strong>
        </div>
        <p><%= review.review %></p>
      </div>
    <% }); %>
  <% } %>


</body>
</html>